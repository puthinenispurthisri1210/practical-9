#include <iostream>
using namespace std;

#define MAX 20
#define INF 999999

int main()
{
    int cost[MAX][MAX];
    int visited[MAX] = {0};
    int n, i, j;
    int edges = 0, min, a = 0, b = 0;
    int mincost = 0;

    cout << "Enter the number of vertices: ";
    cin >> n;

    cout << "Enter the cost adjacency matrix:\n";

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            cin >> cost[i][j];

            if (cost[i][j] == 0)
                cost[i][j] = INF;
        }
    }

    visited[0] = 1;

    cout << "\nEdges in the Minimum Spanning Tree:\n";

    while (edges < n - 1)
    {
        min = INF;

        for (i = 0; i < n; i++)
        {
            if (visited[i])
            {
                for (j = 0; j < n; j++)
                {
                    if (!visited[j] && cost[i][j] < min)
                    {
                        min = cost[i][j];
                        a = i;
                        b = j;
                    }
                }
            }
        }

        if (min == INF)
        {
            cout << "Graph is not connected.\n";
            return 0;
        }

        cout << a + 1 << " - " << b + 1
             << " : " << min << endl;

        mincost += min;
        visited[b] = 1;
        edges++;
    }

    cout << "\nMinimum cost of the spanning tree = "
         << mincost << endl;

    return 0;
}
